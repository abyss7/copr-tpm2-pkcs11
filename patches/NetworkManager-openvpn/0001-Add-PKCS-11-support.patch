 			gs_free char *end_token = NULL;
@@ -1748,15 +1768,18 @@ handle_line_error:
 	}
 
 	/* Determine connection type */
-	if (have_pass) {
+	if (have_pkcs11) {
+		ctype = NM_OPENVPN_CONTYPE_PKCS11;
