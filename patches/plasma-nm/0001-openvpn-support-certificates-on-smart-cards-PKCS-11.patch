+
+QString OpenVpnSettingWidget::pkcs11Id() const
+{
+    // detected entries show a friendly name and keep the ID as item data
+    const int index = d->ui.pkcs11Id->findText(d->ui.pkcs11Id->currentText());
+    if (index >= 0 && !d->ui.pkcs11Id->itemData(index).toString().isEmpty()) {
+        return d->ui.pkcs11Id->itemData(index).toString();
+    }
+    return d->ui.pkcs11Id->currentText().trimmed();
+}
+
+void OpenVpnSettingWidget::setPkcs11Id(const QString &id)
+{
+    const int index = d->ui.pkcs11Id->findData(id);
+    if (index >= 0) {
+        d->ui.pkcs11Id->setCurrentIndex(index);
+    } else {
+        d->ui.pkcs11Id->setEditText(id);
+    }
+}
+
+void OpenVpnSettingWidget::detectPkcs11Ids()
+{
+    if (d->pkcs11Process) {
+        return;
+    }
+
+    const QString openvpn = QStandardPaths::findExecutable(QStringLiteral("openvpn"), {QStringLiteral("/usr/sbin"), QStringLiteral("/sbin")});
+    const QString binary = openvpn.isEmpty() ? QStandardPaths::findExecutable(QStringLiteral("openvpn")) : openvpn;
+    if (binary.isEmpty()) {
+        d->ui.pkcs11Id->setToolTip(i18n("OpenVPN executable not found."));
+        return;
+    }
+
+    d->ui.btnPkcs11Detect->setEnabled(false);
+    d->pkcs11Process = new QProcess(this);
+    d->pkcs11Process->setProcessChannelMode(QProcess::MergedChannels);
+    connect(d->pkcs11Process, &QProcess::finished, this, &OpenVpnSettingWidget::pkcs11DetectFinished);
+    d->pkcs11Process->start(binary, {QStringLiteral("--show-pkcs11-ids"), QStringLiteral(P11KIT_PROXY_MODULE)});
+}
+
+void OpenVpnSettingWidget::pkcs11DetectFinished(int exitCode, QProcess::ExitStatus exitStatus)
+{
+    const QString output = QString::fromLocal8Bit(d->pkcs11Process->readAll());
+    d->pkcs11Process->deleteLater();
+    d->pkcs11Process = nullptr;
+    d->ui.btnPkcs11Detect->setEnabled(true);
+
+    if (exitStatus != QProcess::NormalExit || exitCode != 0) {
+        qCWarning(PLASMA_NM_OPENVPN_LOG) << "openvpn --show-pkcs11-ids failed:" << output;
+    }
+
+    // Each certificate is printed as a block of "Key: value" lines,
+    // the one to use is "Serialized id:".
+    const QString current = pkcs11Id();
+    QString dn;
+    QString friendlyName;
+    QList<QPair<QString, QString>> found;
+    static const QRegularExpression lineRe(QStringLiteral("^\\s*([A-Za-z ]+):\\s*(.*)$"));
+    const QStringList lines = output.split(QLatin1Char('\n'));
+    for (const QString &line : lines) {
+        const QRegularExpressionMatch m = lineRe.match(line);
+        if (!m.hasMatch()) {
+            continue;
+        }
+        const QString key = m.captured(1).trimmed();
+        const QString value = m.captured(2).trimmed();
+        if (key == QLatin1String("DN")) {
+            dn = value;
+        } else if (key == QLatin1String("Friendly name")) {
+            friendlyName = value;
+        } else if (key == QLatin1String("Serialized id")) {
+            const QString label = !friendlyName.isEmpty() ? friendlyName : (!dn.isEmpty() ? dn : value);
+            found.append({label, value});
+            dn.clear();
+            friendlyName.clear();
+        }
+    }
+
+    d->ui.pkcs11Id->clear();
+    for (const auto &[label, id] : std::as_const(found)) {
+        d->ui.pkcs11Id->addItem(label, id);
+        d->ui.pkcs11Id->setItemData(d->ui.pkcs11Id->count() - 1, id, Qt::ToolTipRole);
+    }
+    if (found.isEmpty()) {
+        d->ui.pkcs11Id->setToolTip(i18n("No certificates found. Is the smart card plugged in?"));
+    }
+    if (!current.isEmpty()) {
+        setPkcs11Id(current);
+    }
+    slotWidgetChanged();
 }
 
