--- a/vpn/openvpn/CMakeLists.txt
+++ b/vpn/openvpn/CMakeLists.txt
@@ -23,4 +23,11 @@ target_link_libraries(plasmanetworkmanagement_openvpnui
     KF6::KIOWidgets
 )
 
+# openvpn --show-pkcs11-ids needs a PKCS#11 module, the p11-kit proxy exposes all registered ones
+pkg_get_variable(P11KIT_PROXY_MODULE p11-kit-1 proxy_module)
+if(NOT P11KIT_PROXY_MODULE)
+    set(P11KIT_PROXY_MODULE "${CMAKE_INSTALL_FULL_LIBDIR}/p11-kit-proxy.so")
+endif()
+target_compile_definitions(plasmanetworkmanagement_openvpnui PRIVATE P11KIT_PROXY_MODULE="${P11KIT_PROXY_MODULE}")
+
 install(TARGETS plasmanetworkmanagement_openvpnui  DESTINATION ${KDE_INSTALL_PLUGINDIR}/plasma/network/vpn)
